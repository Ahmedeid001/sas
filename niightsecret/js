
(function () {
    var CONFIG = {
        btnText: 'إضافة سريعة',
        pricePrefix: 'LE ',
        debounceMs: 300
    };
    
    function initProductButtons() {
        var cards = document.querySelectorAll('.group.box-border');
        for (var i = 0; i < cards.length; i++) {
            var card = cards[i];
            if (card.querySelector('.product_card_add_btn')) continue;

            var titleEl = card.querySelector('h3.text-heading');
            var oldBtn = card.querySelector('button[aria-label="Add to cart"]');

            if (!titleEl || !oldBtn) continue;

            var newBtn = document.createElement('button');
            newBtn.className = 'product_card_add_btn';
            newBtn.textContent = CONFIG.btnText;
            (function (ob) {
                newBtn.onclick = function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    ob.click();
                };
            })(oldBtn);
            titleEl.before(newBtn);
        }
    }
    
    function formatPrice(el) {
        if (!el || el.dataset.formatted) return;
        var raw = el.innerText.replace(/[^0-9.]/g, '');
        var num = parseFloat(raw);
        if (isNaN(num)) return;

        var formatted = num.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        el.innerHTML = CONFIG.pricePrefix + formatted;
        el.style.direction = 'rtl';
        el.style.fontFamily = 'sans-serif';
        el.dataset.formatted = 'true';
    }

    function formatAllPrices() {
        var selectors = [
            '#price',
            '#sale-price',
            '.product_price',
            'del',
            'p.line-through',
            '.flex.items-center.gap-1.text-\\[\\#131316\\]',
            'p.text-xl.font-bold.text-\\[\\#010101\\].flex.items-center.gap-1',
            'span.flex.items-center.gap-1.text-xl.md\\:text-\\[32px\\].font-bold.text-\\[\\#010101\\]'
        ].join(',');

        var prices = document.querySelectorAll(selectors);
        for (var i = 0; i < prices.length; i++) {
            formatPrice(prices[i]);
        }
    }
    
    function runAll() {
        initProductButtons();
        formatAllPrices();
    }
    
    var timer = null;
    function debouncedRun() {
        if (timer) return; 
        timer = setTimeout(function () {
            timer = null;
            runAll();
        }, CONFIG.debounceMs);
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runAll);
    } else {
        runAll();
    }
    
    var observer = new MutationObserver(debouncedRun);
    observer.observe(document.body, { childList: true, subtree: true });
})();
 
(function () {
    function setupNSFooter() {
        var footers = document.querySelectorAll('#ns-footer');
        if (footers.length === 0) return;
        
        if (footers.length > 1) {
            for (var j = 1; j < footers.length; j++) {
                footers[j].parentNode.removeChild(footers[j]);
            }
        }
        
        var footer = footers[0]; 
        var oldFooters = document.querySelectorAll('footer:not(#ns-footer)');
        oldFooters.forEach(function(el) {
            el.style.display = 'none';
        });
        
        if (footer.parentNode !== document.body || footer.nextSibling !== null) {
            var oldParent = footer.parentNode;
            document.body.appendChild(footer);
            if (oldParent && oldParent !== document.body && oldParent.innerHTML.trim() === '') {
                oldParent.style.display = 'none';
            }
        }
        
        requestAnimationFrame(function () {
            footer.classList.add('is-ready');
        });
    }

    if (document.readyState === 'complete') {
        setupNSFooter();
    } else {
        window.addEventListener('load', setupNSFooter);
    }
    setInterval(setupNSFooter, 500);
})();
 
(function () {
  const CONFIG = {
    messages: [
      "سرية تامة في التغليف والتوصيل",
      "دفع عند الاستلام | تغليف سري",
      "منتجات أصلية 100%",
      "خصومات العيد تصل إلى 40%"
    ],
    barHeight: 40,
    bg: "#D43A69",
    color: "#FFFCF9",
    speed: 3000
  };

  function initAnnouncementBar() {
    const header = document.querySelector(".bg-white.sticky.top-0.w-full.z-30") || 
                   document.querySelector("header.default_header") || 
                   document.querySelector("header");

    if (!header) return;
    const bar = document.createElement("div");
    bar.id = "modern-announcement-bar";
    bar.style.cssText = `
      background-color: ${CONFIG.bg};
      color: ${CONFIG.color};
      height: ${CONFIG.barHeight}px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
      position: relative;
      z-index: 40;
      overflow: hidden;
      direction: rtl;
    `;

     bar.innerHTML = `
      <button id="ann-prev" style="background:none; border:none; color:inherit; cursor:pointer; padding:0 25px; z-index:10;">❮</button>
      <div id="ann-container" style="position:relative; flex:1; height:100%; display:flex; align-items:center; justify-content:center;">
        ${CONFIG.messages.map((m, i) => `
          <div class="ann-slide" style="position:absolute; opacity:${i===0?1:0}; transform:translateY(${i===0?0:15}px); transition: all 0.4s ease; white-space:nowrap;">${m}</div>
        `).join('')}
      </div>
      <button id="ann-next" style="background:none; border:none; color:inherit; cursor:pointer; padding:0 25px; z-index:10;">❯</button>
    `;

     header.parentNode.insertBefore(bar, header);

     let lastScroll = 0;
    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;
      
      if (currentScroll <= CONFIG.barHeight) {
         header.style.transform = "translateY(0)";
      } else if (currentScroll > lastScroll) {
         header.style.transform = `translateY(-100%)`;
      } else {
         header.style.transform = "translateY(0)";
      }
      lastScroll = currentScroll;
    }, { passive: true });

     let index = 0;
    const slides = bar.querySelectorAll(".ann-slide");
    
    function changeSlide(dir) {
      slides[index].style.opacity = 0;
      slides[index].style.transform = "translateY(-15px)";
      
      index = (index + dir + slides.length) % slides.length;
      
      setTimeout(() => {
        slides[index].style.opacity = 1;
        slides[index].style.transform = "translateY(0)";
      }, 50);
    }

    let autoPlay = setInterval(() => changeSlide(1), CONFIG.speed);
    
    bar.querySelector("#ann-next").onclick = () => { clearInterval(autoPlay); changeSlide(1); };
    bar.querySelector("#ann-prev").onclick = () => { clearInterval(autoPlay); changeSlide(-1); };
  }
  
  if (document.readyState === "complete") initAnnouncementBar();
  else window.addEventListener("load", initAnnouncementBar);
})();

