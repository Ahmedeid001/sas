(function () {
  let tries = 0;
  const MAX_TRIES = 30;

  function initTextIconsCarousel() {
    const region = document.getElementById('text-with-icons');
    const dots = document.querySelectorAll('.page-dots .tap-area');

    if (!region || dots.length === 0) return false;

    function itemWidth() {
      const first = region.querySelector('.text-with-icons__item');
      return first ? first.getBoundingClientRect().width : region.clientWidth;
    }

    function setDot(i) {
      dots.forEach((d, idx) =>
        d.setAttribute('aria-current', String(idx === i))
      );
    }

    function scrollToIndex(i) {
      const w = itemWidth();
       region.scrollTo({
        left: -Math.round(i * w),
        behavior: 'smooth'
      });
      setDot(i);
    }

    dots.forEach((d, i) =>
      d.addEventListener('click', () => scrollToIndex(i))
    );

    let ticking = false;
    region.addEventListener(
      'scroll',
      () => {
        if (window.innerWidth > 768) return;
        if (ticking) return;

        ticking = true;
        requestAnimationFrame(() => {
          const w = itemWidth();
           const i = Math.round(Math.abs(region.scrollLeft) / w);
          setDot(Math.max(0, Math.min(i, dots.length - 1)));
          ticking = false;
        });
      },
      { passive: true }
    );

    return true;
  }

  const interval = setInterval(() => {
    tries++;
    if (initTextIconsCarousel() || tries > MAX_TRIES) {
      clearInterval(interval);
    }
  }, 300);
})();
</script>
