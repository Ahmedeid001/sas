<script>
 (function() {
  function initDotsSystem() {
    const container = document.querySelector('.mt-4.flex.items-center.justify-center.gap-2');
        if (!container) return false;
        if (container.classList.contains('dots-active')) return true;
    
    const prevBtn = container.querySelector('button[aria-label="prev-button"]');
    const nextBtn = container.querySelector('button[aria-label="next-button"]');
    const textSpan = container.querySelector('span');
    if (!prevBtn || !nextBtn || !textSpan) return false;
        container.classList.add('dots-active');

    prevBtn.style.display = 'none';
    nextBtn.style.display = 'none';
    textSpan.style.display = 'none';
    
    const dotsContainer = document.createElement('ul');
    dotsContainer.className = 'flickity-page-dots custom-dots-wrapper';
    
    dotsContainer.style.display = 'flex';
    dotsContainer.style.justifyContent = 'center';
    dotsContainer.style.alignItems = 'center';
    dotsContainer.style.padding = '0';
    dotsContainer.style.listStyle = 'none';
    dotsContainer.style.flexWrap = 'wrap'; 
    dotsContainer.style.maxWidth = '100%'; 

    container.appendChild(dotsContainer);
    
    function getPageInfo() {
        const text = textSpan.textContent || "1 / 1"; 
        const parts = text.split('/');
        return {
            current: parseInt(parts[0]) || 1,
            total: parseInt(parts[1]) || 1
        };
    }
    
    function renderDots() {
        const { current, total } = getPageInfo();
        dotsContainer.innerHTML = ''; 

        let dotSize = '7px';
        let gapSize = '10px';

        if (total > 15) {
            dotSize = '4px';  
            gapSize = '4px';
        } else if (total > 10) {
            dotSize = '5px';
            gapSize = '6px';
        } else if (total > 5) {
            dotSize = '6px';
            gapSize = '8px';
        }

        dotsContainer.style.gap = gapSize;

        for (let i = 1; i <= total; i++) {
            const dot = document.createElement('li');
            dot.style.width = dotSize;
            dot.style.height = dotSize;
            dot.style.borderRadius = '50%';
            dot.style.backgroundColor = (i === current) ? '#6a4a90' : '#e0e0e0'; 
            dot.style.cursor = 'pointer';
            dot.style.transition = 'all 0.2s ease';
            
            if (i === current) {
                dot.style.transform = 'scale(1.3)'; 
            }
            
            dot.onclick = function() {
                const now = getPageInfo().current;
                const diff = i - now;
                if (diff > 0) {
                    for(let k=0; k < diff; k++) nextBtn.click();
                } else if (diff < 0) {
                    for(let k=0; k < Math.abs(diff); k++) prevBtn.click();
                }
            };

            dotsContainer.appendChild(dot);
        }
    }
    
    renderDots();
    const observer = new MutationObserver(renderDots);
    observer.observe(textSpan, { characterData: true, childList: true, subtree: true });

    return true; 
  }
  
   function startDotsPolling() {
      let attempts = 0;
      if (window.dotsTimer) clearInterval(window.dotsTimer);
      
      window.dotsTimer = setInterval(function() {
        const success = initDotsSystem();
        attempts++;
        if (success || attempts > 20) {
            clearInterval(window.dotsTimer);
        }
      }, 500);
  }

   startDotsPolling();

   let lastUrl = location.href; 
  new MutationObserver(() => {
    const url = location.href;
    if (url !== lastUrl) {
      lastUrl = url;
       startDotsPolling();
    }
  }).observe(document, {subtree: true, childList: true});

})();
 
(function () {
  function changeDiscountText() {
    document.querySelectorAll('span').forEach(function (el) {
      const text = el.textContent.trim();
            if (text.includes('خصم') && text.includes('%')) {
                el.textContent = 'تخفيضات'; 
      }
    });
  }
  changeDiscountText();
  const observer = new MutationObserver(changeDiscountText);
  observer.observe(document.body, { childList: true, subtree: true });
})();
(function () {

  function formatPrice(element) {
    if (!element || element.dataset.formatted) return;

    var rawText = element.innerText.replace(/[^0-9.]/g, '');
    var number = parseFloat(rawText);

    if (!isNaN(number)) {
      // التعديل هنا: شيلنا الـ FractionDigits عشان نعرض الرقم صحيح بدون أصفار عشرية
      var formatted = number.toLocaleString('en-US', {
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      });

      element.innerHTML = '<span dir="ltr">' + formatted + '</span> جنيه';
      element.style.direction = 'rtl';
      element.style.fontFamily = 'sans-serif';
      element.dataset.formatted = "true";
    }
  }

  function runFormatting() {
    var allPrices = document.querySelectorAll(
      '#price, #sale-price, .product_price, del, p.line-through ,.flex.items-center.gap-1.text-\\[\\#131316\\]'
    );
    allPrices.forEach(formatPrice);
  }

  runFormatting();

  const observer = new MutationObserver(runFormatting);
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

})();
</script>
