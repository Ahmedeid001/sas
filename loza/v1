      const newBtn = document.createElement('button');
      newBtn.className = 'product_card_add_btn';
      newBtn.innerHTML = `أضف إلي السلة`;
      newBtn.onclick = function (e) {
        e.preventDefault(); 
        e.stopPropagation(); 
        oldBtn.click();
      };
      titleElement.before(newBtn);

    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initProductButtons);
  } else {
    initProductButtons();
  }
  
  const observer = new MutationObserver(initProductButtons);
  observer.observe(document.body, { childList: true, subtree: true });

})();
