<script>
window.API_KEY_TAB = "cd78f340-ef01-4712-aa31-9bde9d9c8604";
window.MAX_PRODUCTS_TAB = 8;

window.getOptimizedImage = function(p) {
    let src = p.thumb || p.image || (p.images && p.images[0]?.url) || (p.images && p.images[0]) || p.cover || "";
    if (!src) return "https://via.placeholder.com/300?text=No+Image";
    if (!src.startsWith('http') && !src.startsWith('//')) {
        return `https://files.easy-orders.net/${src.replace(/^\//, '')}`;
    }
    return src;
};

window.switchTab = function(evt, targetId) {
    document.querySelectorAll('.tab-content').forEach(el => {
        el.classList.remove('active-content');
        el.style.display = 'none';
    });
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

    evt.currentTarget.classList.add('active');
    const panel = document.getElementById(targetId);
    
    if (panel) {
        panel.classList.add('active-content');
        panel.style.display = 'block';
        
        const container = panel.querySelector('.products-horizontal-row');
        const catId = evt.currentTarget.getAttribute('data-id');

        if (container && container.innerHTML.trim() === "") {
            window.fetchProductsHybrid(catId, container);
        }
    }
};

window.fetchProductsHybrid = async function(id, container) {
    container.innerHTML = window.getSkeletonHTML(); 
    
    let url = `/api/v1/products?category_id=${id}`;
    let headers = { 'Content-Type': 'application/json' };
    let products = [];
    let success = false;

    try {
        let response = await fetch(url, { headers });
        if (response.ok) {
            let json = await response.json();
            products = Array.isArray(json) ? json : (json.data || json.products || []);
            if(products.length > 0) success = true;
        }

        if (!success) {
            console.warn("Switching to External API...");
            let extUrl = `https://api.easy-orders.net/api/v1/external-apps/products?category_id=${encodeURIComponent(id)}`;
            let proxyUrl = `https://corsproxy.io/?${encodeURIComponent(extUrl)}`;
            headers['Api-Key'] = window.API_KEY_TAB;
            
            let extResponse = await fetch(proxyUrl, { headers });
            if(extResponse.ok) {
                let extJson = await extResponse.json();
                products = Array.isArray(extJson) ? extJson : (extJson.data || extJson.products || []);
            }
        }

        if (products.length > 0) {
            window.renderProducts(products, container);
        } else {
            container.innerHTML = '<div style="padding:20px;width:100%;text-align:center;color:#666;">لا توجد منتجات حالياً.</div>';
        }

    } catch (error) {
        console.error("Error:", error);
        container.innerHTML = `<p style="text-align:center;color:red;">خطأ في تحميل المنتجات</p>`;
    }
};

window.renderProducts = function(products, container) {
    let html = products.slice(0, window.MAX_PRODUCTS_TAB).map((p, index) => { // ضفنا index
        const title = p.name || p.title || "منتج";
        const price = Math.floor(Number(p.price || p.sale_price || 0));
        const imgUrl = window.getOptimizedImage(p);
        const link = `/products/${p.slug || p.id}`;

        // حساب التأخير: كل كارت يتأخر 100ms عن اللي قبله
        const delay = index * 100; 

        return `
            <a href="${link}" class="product-card-item" style="animation-delay: ${delay}ms">
                <div class="img-holder">
                    <img src="${imgUrl}" alt="${title}" loading="lazy">
                </div>
                <div class="card-details">
                    <h3 class="card-title">${title}</h3>
                    <div class="card-price">${price} EGP</div>
                </div>
            </a>`;
    }).join('');
    container.innerHTML = html;
};

window.getSkeletonHTML = function() {
    return Array(4).fill(0).map(() => `
        <div class="skeleton-card">
            <div class="skeleton-img"></div>
            <div class="skeleton-text"></div>
            <div class="skeleton-price"></div>
        </div>
    `).join('');
};

// =================================
// تفعيل القسم الأول بشكل تلقائي
// =================================
document.addEventListener("DOMContentLoaded", function() {
    const firstBtn = document.querySelector('.tabs-navigation .tab-btn.active') || 
                     document.querySelector('.tabs-navigation .tab-btn');

    // إذا وجد زر، تشغيل التبويب تلقائيًا
    if (firstBtn) {
        firstBtn.click();
    }
});
</script>
