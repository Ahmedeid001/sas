<script>
(function() {
    function addEyeToSearch() {
     
        const searchCards = document.querySelectorAll('main .grid div[role="button"]');

        searchCards.forEach(card => {
            if (card.querySelector('.quick-view-eye')) return;

            const imgWrapper = card.querySelector('.relative.overflow-hidden');
            
            if (imgWrapper) {
                // إنشاء الزرار
                const btn = document.createElement('button');
                btn.className = 'quick-view-eye';
                btn.type = 'button';
                btn.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" style="width:18px;height:18px;">
                      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="#f4f3e1" stroke-width="1.8"/>
                      <path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" stroke="#f4f3e1" stroke-width="1.8"/>
                    </svg>
                `;

                btn.onclick = function(e) {
                    e.stopPropagation(); 
                    e.preventDefault();
                    card.click(); 
                };
                imgWrapper.appendChild(btn);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', addEyeToSearch);

    const observer = new MutationObserver((mutations) => {
        addEyeToSearch();
    });
        const gridContainer = document.querySelector('main');
    if (gridContainer) {
        observer.observe(gridContainer, { childList: true, subtree: true });
    } else {
        observer.observe(document.body, { childList: true, subtree: true });
    }
})();
</script>

