</style><script>
(function () {
  function restructureCartCounter() {
    document.querySelectorAll('.cart-item-quantity-counter').forEach((container) => {
      // 1. لو الـ container ده متعدل قبل كدة، نعدي عليه
      if (container.querySelector('.qty-box-wrapper')) return;

      // 2. البحث عن زرار الحذف (اللي واخد كلاس ms-2)
      const deleteBtn = container.querySelector('button.ms-2');
      if (!deleteBtn) return;

      // 3. إنشاء حاوية جديدة تجمع العداد (الزائد والناقص والرقم)
      const qtyWrapper = document.createElement('div');
      qtyWrapper.className = 'qty-box-wrapper';

      // 4. سحب كل العناصر ما عدا زرار الحذف ونقلهم للحاوية الجديدة
      Array.from(container.childNodes).forEach(node => {
          if (node !== deleteBtn) {
              qtyWrapper.appendChild(node);
          }
      });

      // 5. مسح محتويات الـ container الأصلي وإعادة ترتيبه بشياكة
      container.innerHTML = '';
      container.appendChild(qtyWrapper); // العداد على اليمين
      container.appendChild(deleteBtn); // السلة على الشمال
      
      // إضافة كلاس للتنسيق
      container.classList.add('flex-split-layout');
      deleteBtn.classList.add('custom-trash-btn');
    });
  }

  const obs = new MutationObserver(() => restructureCartCounter());
  obs.observe(document.documentElement, { childList: true, subtree: true });
  restructureCartCounter();
})();
