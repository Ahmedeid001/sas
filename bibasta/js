(function () {
  let tries = 0;
  const MAX_TRIES = 30;

  function initBibIconsCarousel() {
    const region = document.getElementById('bib-icons-slider');
    const dots = document.querySelectorAll('.bib-dots button');

    if (!region || dots.length === 0) return false;

    function itemWidth() {
      const first = region.querySelector('.bib-item');
      return first ? first.getBoundingClientRect().width : region.clientWidth;
    }

    function setDot(i) {
      dots.forEach((d, idx) =>
        d.setAttribute('aria-current', String(idx === i))
      );
    }

    function scrollToIndex(i) {
      const w = itemWidth();
      region.scrollTo({
        left: -Math.round(i * w),
        behavior: 'smooth'
      });
      setDot(i);
    }

    // إضافة التحريك التلقائي
    let autoPlayTimer;
    let currentIndex = 0;

    function startAutoPlay() {
      stopAutoPlay(); // تأكيد الإيقاف قبل التشغيل عشان ميتكررش
      autoPlayTimer = setInterval(() => {
        // نوقف الحركة التلقائية لو إحنا على الديسكتوب (لأن العناصر معروضة كلها)
        if (window.innerWidth > 992) return;

        // نجيب الإندكس الحالي بدقة عشان لو العميل حرك السلايدر بإيده
        const w = itemWidth();
        currentIndex = Math.round(Math.abs(region.scrollLeft) / w);
        
        currentIndex++;
        // لو وصلنا للآخر، نرجع للأول
        if (currentIndex >= dots.length) {
          currentIndex = 0;
        }
        
        scrollToIndex(currentIndex);
      }, 3000); // بيتحرك كل 3 ثواني (تقدر تعدلها)
    }

    function stopAutoPlay() {
      clearInterval(autoPlayTimer);
    }

    function resetAutoPlay() {
      stopAutoPlay();
      startAutoPlay();
    }

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        scrollToIndex(i);
        resetAutoPlay(); // نرستر العداد لو العميل داس على زرار
      })
    );

    let ticking = false;
    region.addEventListener(
      'scroll',
      () => {
        if (window.innerWidth > 992) return;
        if (ticking) return;

        ticking = true;
        requestAnimationFrame(() => {
          const w = itemWidth();
          const i = Math.round(Math.abs(region.scrollLeft) / w);
          setDot(Math.max(0, Math.min(i, dots.length - 1)));
          ticking = false;
        });
      },
      { passive: true }
    );

    // توقيف السلايدر لو الماوس عليه أو العميل لامس الشاشة (مهمة لراحة العميل)
    region.addEventListener('mouseenter', stopAutoPlay);
    region.addEventListener('mouseleave', startAutoPlay);
    region.addEventListener('touchstart', stopAutoPlay, {passive: true});
    region.addEventListener('touchend', startAutoPlay);

    // تشغيل الـ Auto-play
    startAutoPlay();

    return true;
  }

  const interval = setInterval(() => {
    tries++;
    if (initBibIconsCarousel() || tries > MAX_TRIES) {
      clearInterval(interval);
    }
  }, 300);
})();
 
 (function() {
    function initCarousel() {
        const track = document.getElementById('review-track');
        const nextBtn = document.querySelector('.carousel-arrow.next');
        const prevBtn = document.querySelector('.carousel-arrow.prev');

        if (!track) return false;

        function getScrollAmount() {
            const card = track.querySelector('.carousel-card');
            return card ? card.offsetWidth + 20 : 280; // 20 هي قيمة الـ gap
        }

        // تشغيل زراير التحكم اليدوية
        if (nextBtn) {
            nextBtn.addEventListener('click', () => {
                track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', () => {
                track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
            });
        }
 
        let autoScrollTimer;

        function startAutoScroll() {
            autoScrollTimer = setInterval(() => {
                const maxScroll = track.scrollWidth - track.clientWidth;
                
                // التأكد إذا كان السلايدر وصل للآخر (Math.abs لأن المواقع العربي الـ scroll بيكون بالسالب)
                if (Math.abs(track.scrollLeft) >= maxScroll - 20) {
                    track.scrollTo({ left: 0, behavior: 'smooth' }); // الرجوع لأول صورة
                } else {
                    track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' }); // التحرك للصورة التالية
                }
            }, 2500); // 2500 = الحركة كل ثانيتين ونص (تقدر تزودها أو تنقصها براحتك)
        }

        function stopAutoScroll() {
            clearInterval(autoScrollTimer);
        }

        // تشغيل الحركة التلقائية
        startAutoScroll();

        // إيقاف الحركة التلقائية عند وضع الماوس أو اللمس (عشان العميل يقرأ الريفيو)
        track.addEventListener('mouseenter', stopAutoScroll);
        track.addEventListener('mouseleave', startAutoScroll);
        track.addEventListener('touchstart', stopAutoScroll, {passive: true});
        track.addEventListener('touchend', startAutoScroll);

        return true; // تأكيد إن السكريبت اشتغل
    }

    // طريقة تشغيل آمنة تتوافق مع منصة إيزي أوردر
    let checkExist = setInterval(function() {
        if (initCarousel()) {
            clearInterval(checkExist); // أول ما يشتغل نوقف البحث
        }
    }, 500);

     setTimeout(() => {
        clearInterval(checkExist);
    }, 10000);
})();
  (function() {
    var minDisplayTime = 800; 
    var loadStartTime = Date.now();

    function dismissLoader() {
        var loader = document.getElementById('bib-creative-loader');
        if (loader) {
            loader.classList.add('fade-out');
                        setTimeout(function() {
                loader.remove();
            }, 450);
        }
    }
    window.addEventListener('load', function() {
        var timePassed = Date.now() - loadStartTime;
        var timeRemaining = Math.max(0, minDisplayTime - timePassed);
        setTimeout(dismissLoader, timeRemaining);
    });
    setTimeout(dismissLoader, 3000);
})();

 
 (function() {
     function initOrlineCarousel() {
        var track = document.getElementById('review-track');
        var nextBtn = document.querySelector('.carousel-arrow.next');
        var prevBtn = document.querySelector('.carousel-arrow.prev');

         if (!track || !nextBtn || !prevBtn || track.dataset.initialized) {
            return false;
        }

         track.dataset.initialized = 'true';

        function getScrollAmount() {
            var card = track.querySelector('.carousel-card');
            // Card width + gap (20px)
            return card ? card.offsetWidth + 20 : 280; 
        }

         nextBtn.addEventListener('click', function(e) {
            e.preventDefault(); // Prevent any default button behavior
             track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });

        prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
             // Positive left scroll moves it "backward" visually in RTL
            track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });

        return true;
    }
    initOrlineCarousel();
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOrlineCarousel);
    }
    var attempts = 0;
    var maxAttempts = 20; // Try for 10 seconds total
    var pollingTimer = setInterval(function() {
        if (initOrlineCarousel() || attempts >= maxAttempts) {
            clearInterval(pollingTimer);
        }
        attempts++;
    }, 500);
    var observer = new MutationObserver(function(mutations) {
        var track = document.getElementById('review-track');
        if (track && !track.dataset.initialized) {
           initOrlineCarousel();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });

})();
